---
import SiteLayout from '../layouts/SiteLayout.astro';
import wp from '../data/wordpress-content.json';
import { decodeEntities, stripHtml, transformWordPressHtml } from '../lib/wp';

export function getStaticPaths() {
	return wp.items
		.filter((item) => item.path !== '/')
		.map((item) => ({
			params: { slug: item.path.slice(1) },
			props: { item },
		}));
}

const { item } = Astro.props;
const cleanTitle = decodeEntities(stripHtml(item.title || item.slug));
const description =
	decodeEntities(stripHtml(item.excerpt || item.content)).slice(0, 180) ||
	`Article by Cesar Spinozzi: ${cleanTitle}`;
const pageHtml = transformWordPressHtml(item.content);
const renderedElementorId = item?.meta?.renderedElementorId ?? item.id;
const renderedElementorType = item?.meta?.renderedElementorType;
const bodyClass =
	item.path === '/blog' || renderedElementorType === 'archive'
		? `blog wp-embed-responsive wp-theme-hello-elementor hello-elementor-default elementor-page-${renderedElementorId} elementor-default elementor-template-full-width elementor-kit-34`
		: `page page-id-${item.id} elementor-default elementor-kit-34 elementor-page elementor-page-${renderedElementorId}`;
---

<SiteLayout
	title={`${cleanTitle} | Cesar Spinozzi`}
	description={description}
	path={item.path}
	wpPostId={renderedElementorId}
	useWpStyles={true}
	bodyClass={bodyClass}
>
	<main class="wp-shell">
		<div set:html={pageHtml}></div>
	</main>
</SiteLayout>
