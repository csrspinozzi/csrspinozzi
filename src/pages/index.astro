---
import SiteLayout from '../layouts/SiteLayout.astro';
import wp from '../data/wordpress-content.json';
import { decodeEntities, stripHtml, transformWordPressHtml } from '../lib/wp';

const home = wp.items.find((item) => item.path === '/');
if (!home) {
	throw new Error('WordPress home content not found in src/data/wordpress-content.json');
}

const title = `${decodeEntities(stripHtml(home.title))} | Cesar Spinozzi`;
const description =
	decodeEntities(stripHtml(home.excerpt)).slice(0, 180) ||
	'Lead Designer, Senior Product Designer, and UX/UI Designer.';
const homeHtml = transformWordPressHtml(home.content);
---

<SiteLayout
	title={title}
	description={description}
	path="/"
	wpPostId={home.id}
	useWpStyles={true}
	bodyClass={`home page-template-default page page-id-${home.id} elementor-default elementor-kit-34 elementor-page elementor-page-${home.id}`}
>
	<main class="wp-shell">
		<div set:html={homeHtml}></div>
	</main>
</SiteLayout>
