---
import '../styles/global.css';
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
	title: string;
	description: string;
	path?: string;
	image?: string;
	schema?: Record<string, unknown>[];
	bodyClass?: string;
	wpPostId?: number;
	useWpStyles?: boolean;
	showHeader?: boolean;
}

const {
	title,
	description,
	path = '/',
	image = '/og-image.svg',
	schema = [],
	bodyClass = '',
	wpPostId,
	useWpStyles = false,
	showHeader = true,
} = Astro.props as Props;

const origin = Astro.site ?? new URL('https://csrspinozzi.com');
const canonical = new URL(path, origin).toString();
const ogImage = new URL(image, origin).toString();
const normalize = (value: string) => (value.endsWith('/') && value !== '/' ? value.slice(0, -1) : value);
const currentPath = normalize(path);
const isActive = (href: string) => currentPath === normalize(href);
const wpCommonStylesHref = '/wp-css/legacy-common.css';
const wpPostStylesHref = wpPostId ? `/wp-css/post-${wpPostId}.css` : null;
const wpPostStylesPath = wpPostStylesHref ? join(process.cwd(), 'public', wpPostStylesHref.slice(1)) : null;
const hasWpPostStyles =
	!!wpPostStylesPath && existsSync(wpPostStylesPath) && statSync(wpPostStylesPath).size > 0;
const socialLinks = {
	email: 'mailto:csrspinozzi@gmail.com',
	linkedin: 'https://www.linkedin.com/in/csrspinozzi/',
	behance: 'https://www.behance.net/csrspinozzi',
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
			<link rel="canonical" href={canonical} />
			<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
			<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
			<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
			<link rel="icon" href="/favicon.ico" />
			<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{useWpStyles && <link rel="stylesheet" href={wpCommonStylesHref} media="all" />}
		{useWpStyles && hasWpPostStyles && wpPostStylesHref && <link rel="stylesheet" href={wpPostStylesHref} media="all" />}
		{useWpStyles && <script src="/wp-compat.js" defer></script>}

		{schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
	</head>
		<body class:list={[bodyClass, { 'has-site-header': showHeader }]}>
			{
				showHeader && (
					<header class="site-header" aria-label="Primary">
						<div class="site-header__inner">
							<a href="/" class="site-brand">
								<img src="/brand/logo-64.png" alt="csrspinozzi" width="24" height="24" loading="eager" decoding="async" />
								<span>csrspinozzi</span>
							</a>
							<div class="site-nav-shell" data-site-nav-shell>
								<button class="site-nav-toggle" type="button" aria-label="Menu" aria-controls="site-nav" aria-expanded="false">
									<span class="site-nav-toggle__icon" aria-hidden="true"></span>
									<span class="sr-only">Menu</span>
								</button>
								<nav id="site-nav" class="site-nav" aria-label="Menu">
									<ul class="site-nav__list">
										<li class="site-nav__mobile-only"><a class:list={['site-nav__link', { active: isActive('/') }]} href="/">home</a></li>
										<li><a class:list={['site-nav__link', { active: isActive('/about-me') }]} href="/about-me">about</a></li>
										<li class="site-nav__has-submenu">
											<a
												class:list={['site-nav__link', { active: isActive('/jitsi-case-study') || isActive('/meerkapp-case-study-english') || isActive('/teduka-case-study') }]}
												href="/jitsi-case-study"
											>
												projects
											</a>
											<ul class="site-nav__submenu">
												<li><a class="site-nav__sublink" href="/jitsi-case-study">Jitsi UI</a></li>
												<li><a class="site-nav__sublink" href="/meerkapp-case-study-english">Meerkapp</a></li>
												<li><a class="site-nav__sublink" href="/teduka-case-study">Teduka</a></li>
											</ul>
										</li>
										<li>
											<a class="site-nav__link" href="https://www.behance.net/csrspinozzi" target="_blank" rel="noopener noreferrer">
												behance
											</a>
										</li>
										<li>
											<a
												class="site-nav__link"
												href="https://drive.google.com/file/d/1lBE1WyUwU4kp2r1y102ExddOMRsx8ip2/view?usp=drive_link"
												target="_blank"
												rel="noopener noreferrer"
											>
												resume
											</a>
										</li>
									</ul>
								</nav>
							</div>
						</div>
					</header>
				)
			}
			<slot />
			<footer class="site-social-footer" aria-label="Contact links">
				<div class="site-social-footer__inner">
					<a class="site-social-link" href={socialLinks.email}>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M4.5 6h15A1.5 1.5 0 0 1 21 7.5v9A1.5 1.5 0 0 1 19.5 18h-15A1.5 1.5 0 0 1 3 16.5v-9A1.5 1.5 0 0 1 4.5 6Zm0 1.5V8l7.5 5 7.5-5v-.5h-15Zm15 9v-6.7l-7.1 4.8a.75.75 0 0 1-.8 0L4.5 9.8v6.7h15Z" />
						</svg>
						<span>Email</span>
					</a>
					<a class="site-social-link" href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer">
						<span class="site-social-link__glyph" aria-hidden="true">in</span>
						<span>LinkedIn</span>
					</a>
					<a class="site-social-link" href={socialLinks.behance} target="_blank" rel="noopener noreferrer">
						<span class="site-social-link__glyph" aria-hidden="true">Bē</span>
						<span>Behance</span>
					</a>
				</div>
			</footer>
			<script is:inline>
				(() => {
					const header = document.querySelector('.site-header');
					const shell = document.querySelector('[data-site-nav-shell]');
					const canUseNav = !!shell;
					if (!header && !canUseNav) return;

					let lastY = window.scrollY || 0;
					let ticking = false;
					const applyHeaderVisibility = () => {
						ticking = false;
						if (!header) return;
						const currentY = window.scrollY || 0;
						const delta = currentY - lastY;
						if (Math.abs(delta) < 6) return;

						if (canUseNav && shell.classList.contains('is-open')) {
							header.classList.remove('site-header--hidden');
							lastY = currentY;
							return;
						}

						if (currentY <= 8) {
							header.classList.remove('site-header--hidden');
						} else if (delta > 0 && currentY > 120) {
							header.classList.add('site-header--hidden');
						} else if (delta < 0) {
							header.classList.remove('site-header--hidden');
						}
						lastY = currentY;
					};

					window.addEventListener(
						'scroll',
						() => {
							if (ticking) return;
							ticking = true;
							requestAnimationFrame(applyHeaderVisibility);
						},
						{ passive: true }
					);

					if (!shell) return;
					const button = shell.querySelector('.site-nav-toggle');
					const nav = shell.querySelector('.site-nav');
					if (!button || !nav) return;
					const closeMenu = () => {
						shell.classList.remove('is-open');
						button.setAttribute('aria-expanded', 'false');
						if (header) header.classList.remove('site-header--hidden');
					};
					button.addEventListener('click', () => {
						const nextOpen = !shell.classList.contains('is-open');
						shell.classList.toggle('is-open', nextOpen);
						button.setAttribute('aria-expanded', String(nextOpen));
						if (nextOpen && header) header.classList.remove('site-header--hidden');
					});
					document.addEventListener('click', (event) => {
						if (!shell.contains(event.target)) closeMenu();
					});
					window.addEventListener('resize', () => {
						if (window.innerWidth > 920) closeMenu();
					});
				})();
			</script>
		</body>
	</html>
